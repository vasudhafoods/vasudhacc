# Shopify custom app credentials. Copy to .env.local and fill in locally.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=replace_with_dev_dashboard_client_id
SHOPIFY_CLIENT_SECRET=replace_with_dev_dashboard_client_secret
SHOPIFY_API_VERSION=2026-07
# Optional stable public HTTPS origin for Shopify webhooks. Vercel's production URL is used when omitted.
APP_BASE_URL=https://commandcenter.example.com

# Required dashboard login and signed 12-hour sessions.
DASHBOARD_USERNAME=vadmin
DASHBOARD_PASSWORD=replace_with_a_strong_password_of_at_least_12_characters
SESSION_SECRET=replace_with_at_least_32_random_characters

# Neon PostgreSQL pooled connection string. Keep the real value in .env.local and Vercel only.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Used to protect internal inventory and future cron endpoints.
CRON_SECRET=replace_with_a_long_random_value

# Optional daily summary email (Resend). Enable the channel in dashboard Settings.
RESEND_API_KEY=
ALERT_EMAIL_FROM=Vasudha Command Center <alerts@your-verified-domain.com>
# Comma-separated management recipients.
ALERT_EMAIL_TO=management@example.com

# Optional WhatsApp Cloud API approved template. Enable in dashboard Settings.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ALERT_WHATSAPP_TO=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_API_VERSION=v23.0
